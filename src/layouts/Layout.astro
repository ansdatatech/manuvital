---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Yenimahalle'nin kalbinde, refleksoloji ve manuel terapi uzmanlığıyla yenilenin. Bütüncül sağlık merkezimizde stresten arının." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph / Sosyal Medya Paylaşım Etiketleri -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://www.manuvital.com/" /> <!-- İleride gerçek domain ile değiştirilecek -->
		<meta property="og:title" content="Manuvital Terapi Merkezi | Ankara Refleksoloji" />
		<meta property="og:description" content="Uzman kadromuz ve bütüncül sağlık yaklaşımımızla bedensel dengenizi yeniden kazandırıyoruz." />
		<meta property="og:image" content="https://www.manuvital.com/logo.png" />

		<!-- Temel Analitik Veri Akışı (GA4 Placeholder) -->
		<!-- Not: Gerçek bir Google Analytics ID'si aldığınızda bu yorum satırlarını kaldırıp G-XXXXX kısmını güncelleyebilirsiniz. -->
		<!--
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
		<script>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-XXXXXXXXXX');
		</script>
		-->
	</head>
	<body class="font-sans bg-brand-light text-brand-dark antialiased min-h-screen flex flex-col justify-between">
		<Header />
		<div class="flex-grow">
			<slot />
		</div>
		<Footer />
		<!-- WhatsApp Yüzen Buton -->
		<a
			href="https://wa.me/905358888868"
			target="_blank"
			rel="noopener noreferrer"
			class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-[#25D366] text-white rounded-full shadow-lg hover:bg-[#20b858] hover:scale-110 hover:shadow-xl transition-all duration-300 group"
			aria-label="WhatsApp ile İletişime Geçin"
		>
			<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
				<path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
			</svg>
		</a>
	</body>
</html>