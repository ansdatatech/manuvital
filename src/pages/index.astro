---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout title="Manuvital Terapi Merkezi | Ankara Refleksoloji">
	<main>
		<!-- HERO SECTION -->
		<section class="relative bg-white pt-24 pb-32 overflow-hidden">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
				<div class="text-center max-w-3xl mx-auto">
					<h1 class="text-4xl tracking-tight font-extrabold text-brand-dark sm:text-5xl md:text-6xl">
						<span class="block">Bedeninize İyi Gelen</span>
						<span class="block text-brand-turquoise mt-2">Profesyonel Dokunuş</span>
					</h1>
					<p class="mt-6 text-base text-gray-500 sm:text-lg md:mt-8 md:text-xl">
						Yenimahalle'nin kalbinde, refleksoloji ve manuel terapi uzmanlığıyla yenilenin. Sağlıklı yaşam merkezinizde stresten arının, enerjinizi geri kazanın.
					</p>
					<div class="mt-10 flex justify-center gap-4">
						<div class="rounded-md shadow">
                            <!-- YENİ: "Hemen Randevu Al" butonu artık modal'ı (açılır pencereyi) açıyor -->
							<button onclick="document.getElementById('randevuModal').classList.remove('hidden')" class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-brand-turquoise hover:bg-teal-700 transition duration-300 md:py-4 md:text-lg cursor-pointer">
								Hemen Randevu Al
							</button>
						</div>
						<div class="rounded-md shadow">
							<a href="#hizmetler" class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-brand-turquoise bg-white border-brand-turquoise hover:bg-gray-50 transition duration-300 md:py-4 md:text-lg">
								Hizmetlerimizi İncele
							</a>
						</div>
					</div>
					
					<div class="mt-12 flex items-center justify-center space-x-2">
						<div class="flex text-brand-gold text-xl">
							★★★★★
						</div>
						<span class="text-sm text-gray-600 font-medium">Google'da 5.0 Puan (59 Değerlendirme)</span>
					</div>
				</div>
			</div>
			
			<div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-brand-turquoise opacity-5 blur-3xl z-0"></div>
			<div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-brand-gold opacity-5 blur-3xl z-0"></div>
		</section>
		
		<!-- HİZMETLER SECTION -->
		<section id="hizmetler" class="py-20 bg-brand-light">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center">
					<h2 class="text-3xl font-extrabold text-brand-dark sm:text-4xl">
						Uzmanlık Alanlarımız
					</h2>
					<p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto">
						Modern teknikler, deneyimli dokunuşlar ve geleneksel yöntemlerle yaşam kalitenizi artırıyoruz.
					</p>
				</div>

				<div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
					
					<!-- Kart 1: Refleksoloji -->
					<div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
						<div class="p-8">
							<div class="w-14 h-14 inline-flex items-center justify-center rounded-lg bg-brand-turquoise text-white mb-5 shadow-sm">
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                                </svg>
							</div>
							<h3 class="text-2xl font-bold text-brand-dark mb-3">Klinik Refleksoloji</h3>
							<p class="text-gray-600 text-base leading-relaxed">
								El ve ayaklardaki belirli noktalara uygulanan özel masaj teknikleriyle sinir sistemini rahatlatır, vücudun doğal dengeye kavuşmasını destekleriz.
							</p>
						</div>
					</div>

					<!-- Kart 2: Manuel Terapi -->
					<div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
						<div class="p-8">
							<div class="w-14 h-14 inline-flex items-center justify-center rounded-lg bg-brand-gold text-white mb-5 shadow-sm">
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11" />
                                </svg>
							</div>
							<h3 class="text-2xl font-bold text-brand-dark mb-3">Manuel Terapi</h3>
							<p class="text-gray-600 text-base leading-relaxed">
								Kas ve eklem sistemindeki fonksiyonel bozuklukları gidermek için cihaz kullanmadan, tamamen elle uygulanan profesyonel bir iyileştirme yöntemidir.
							</p>
						</div>
					</div>

					<!-- Kart 3: Hacamat -->
					<div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
						<div class="p-8">
							<div class="w-14 h-14 inline-flex items-center justify-center rounded-lg bg-brand-gold text-white mb-5 shadow-sm">
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                </svg>
							</div>
							<h3 class="text-2xl font-bold text-brand-dark mb-3">Kupa Terapisi (Hacamat)</h3>
							<p class="text-gray-600 text-base leading-relaxed">
								Vücuttaki toksinlerin atılmasını sağlayan, kan dolaşımını hızlandıran ve bağışıklık sistemini destekleyen geleneksel, hijyenik kupa uygulaması.
							</p>
						</div>
					</div>

					<!-- Kart 4: Bütüncül Yaklaşım -->
					<div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
						<div class="p-8">
							<div class="w-14 h-14 inline-flex items-center justify-center rounded-lg bg-brand-turquoise text-white mb-5 shadow-sm">
								<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
							</div>
							<h3 class="text-2xl font-bold text-brand-dark mb-3">Bütüncül Sağlık</h3>
							<p class="text-gray-600 text-base leading-relaxed">
								Sadece semptomlara değil, problemin kaynağına odaklanarak kişiye özel, yapısal analiz içeren detaylı bir terapi haritası çıkarıyoruz.
							</p>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- MÜŞTERİ YORUMLARI -->
		<Testimonials />
		
		<!-- HAKKIMIZDA & LOKASYON SECTION -->
		<section id="hakkimizda" class="py-20 bg-white border-t border-gray-100">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<span class="text-brand-turquoise font-semibold uppercase tracking-wider text-sm">Beştepe, Yenimahalle</span>
						<h2 class="mt-2 text-3xl font-extrabold text-brand-dark sm:text-4xl">
							Manuvital Terapi Merkezi
						</h2>
						<p class="mt-4 text-lg text-gray-600 leading-relaxed">
							Sağlıklı yaşam ve bedensel dengeyi odağına alan merkezimiz, kişiye özel refleksoloji masajı ve manuel terapi uygulamalarıyla hizmet vermektedir. Günün stresinden arınmak, kas gerginliklerini hafifletmek ve bedeninizin doğal şifa mekanizmasını desteklemek için profesyonel bir ortam sunuyoruz.
						</p>

						<div class="mt-8 space-y-4">
							<div class="flex items-start">
								<div class="flex-shrink-0 mt-1">
									<div class="w-10 h-10 rounded-full bg-brand-turquoise/10 flex items-center justify-center text-brand-turquoise">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
									</div>
								</div>
								<div class="ml-4">
									<h4 class="text-base font-semibold text-brand-dark">Adres</h4>
									<p class="text-gray-600 text-sm">Beştepe, Zübeyde Hanım Cd. No: 56/16, 06560 Yenimahalle / Ankara</p>
								</div>
							</div>

							<div class="flex items-start">
								<div class="flex-shrink-0 mt-1">
									<div class="w-10 h-10 rounded-full bg-brand-gold/10 flex items-center justify-center text-brand-gold">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
									</div>
								</div>
								<div class="ml-4">
									<h4 class="text-base font-semibold text-brand-dark">Telefon</h4>
									<p class="text-gray-600 text-sm"><a href="tel:+905358888868" class="hover:text-brand-turquoise transition-colors">0535 888 88 68</a></p>
								</div>
							</div>

							<div class="flex items-start">
								<div class="flex-shrink-0 mt-1">
									<div class="w-10 h-10 rounded-full bg-brand-turquoise/10 flex items-center justify-center text-brand-turquoise">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									</div>
								</div>
								<div class="ml-4">
									<h4 class="text-base font-semibold text-brand-dark">Çalışma Saatleri</h4>
									<p class="text-gray-600 text-sm">Hafta İçi & Cumartesi: 09:00 - 18:00</p>
								</div>
							</div>
						</div>

						<div class="mt-8">
							<a href="https://maps.google.com/?q=Be%C5%9Ftepe,+Z%C3%BCbeyde+Han%C4%B1m+Cd+56/16,+Yenimahalle/Ankara" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-brand-turquoise hover:bg-teal-700 transition duration-300 shadow">
								<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
								Google Haritalar'da Aç / Yol Tarifi
							</a>
						</div>
					</div>

					<div class="h-96 lg:h-full min-h-[400px] w-full rounded-2xl overflow-hidden shadow-lg border border-gray-200">
						<iframe 
							title="Manuvital Terapi Merkezi Harita Konumu"
							src="https://maps.google.com/maps?q=ManuvitalTerapi%20Merkezi,%20Yenimahalle,%20Ankara&t=&z=16&ie=UTF8&iwloc=&output=embed" 
							width="100%" 
							height="100%" 
							style="border:0;" 
							allowfullscreen="" 
							loading="lazy" 
							referrerpolicy="no-referrer-when-downgrade">
						</iframe>
					</div>
				</div>
			</div>
		</section>

        <!-- YENİ: RANDEVU SEÇİM VE TAKVİM MODALI (POPUP) -->
        <div id="randevuModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
            <!-- Arka plan bulanıklığı -->
            <div class="fixed inset-0 bg-gray-900 bg-opacity-75 transition-opacity backdrop-blur-sm" onclick="kapatModal()"></div>

            <div class="fixed inset-0 z-10 overflow-y-auto">
                <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                    <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg border-t-4 border-brand-turquoise">
                        
                        <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                            <div class="sm:flex sm:items-start">
                                <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                    <h3 class="text-2xl font-bold leading-6 text-gray-900 mb-2" id="modal-title">Randevu Talebi</h3>
                                    <p class="text-sm text-gray-500 mb-6">Lütfen hizmet almak istediğiniz alanı veya uzmanı seçin.</p>
                                    
                                    <!-- ADIM 1: Seçim Ekranı -->
                                    <div id="secimEkrani" class="space-y-4">
                                        <!-- WhatsApp Yönlendirmeleri -->
                                        <a href="https://wa.me/905358888868?text=Merhaba,%20Hüseyin%20Hoca'dan%20refleksoloji%20randevusu%20almak%20istiyorum." target="_blank" class="w-full flex justify-between items-center px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl hover:bg-green-50 hover:border-green-300 transition-colors cursor-pointer group">
                                            <div>
                                                <h4 class="font-bold text-gray-800 group-hover:text-green-700">Hüseyin Hoca</h4>
                                                <p class="text-xs text-gray-500">Refleksoloji Masajı</p>
                                            </div>
                                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold flex items-center">
                                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                                                WhatsApp'tan Al
                                            </span>
                                        </a>

                                        <a href="https://wa.me/905358888868?text=Merhaba,%20Hacamat%20işlemi%20için%20randevu%20almak%20istiyorum." target="_blank" class="w-full flex justify-between items-center px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl hover:bg-green-50 hover:border-green-300 transition-colors cursor-pointer group">
                                            <div>
                                                <h4 class="font-bold text-gray-800 group-hover:text-green-700">Hacamat (Kupa Terapisi)</h4>
                                                <p class="text-xs text-gray-500">Mürüvet Hoca & Erdoğan Hoca</p>
                                            </div>
                                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold flex items-center">
                                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                                                WhatsApp'tan Al
                                            </span>
                                        </a>

                                        <!-- Çevrimiçi Takvim Yönlendirmeleri -->
                                        <div onclick="takvimeGec('irem')" class="w-full flex justify-between items-center px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl hover:bg-cyan-50 hover:border-cyan-300 transition-colors cursor-pointer group">
                                            <div>
                                                <h4 class="font-bold text-gray-800 group-hover:text-brand-turquoise">İrem Hoca</h4>
                                                <p class="text-xs text-gray-500">Manuel Terapi</p>
                                            </div>
                                            <span class="bg-cyan-100 text-brand-turquoise px-3 py-1 rounded-full text-xs font-bold">Saat Seç &rarr;</span>
                                        </div>

                                        <div onclick="takvimeGec('erdogan')" class="w-full flex justify-between items-center px-4 py-4 bg-gray-50 border border-gray-200 rounded-xl hover:bg-cyan-50 hover:border-cyan-300 transition-colors cursor-pointer group">
                                            <div>
                                                <h4 class="font-bold text-gray-800 group-hover:text-brand-turquoise">Erdoğan Hoca</h4>
                                                <p class="text-xs text-gray-500">Manuel Terapi</p>
                                            </div>
                                            <span class="bg-cyan-100 text-brand-turquoise px-3 py-1 rounded-full text-xs font-bold">Saat Seç &rarr;</span>
                                        </div>
                                    </div>

                                    <!-- ADIM 2: Takvim ve Form Ekranı (Başlangıçta Gizli) -->
                                    <div id="takvimEkrani" class="hidden">
                                        <button onclick="geriDon()" class="text-sm text-gray-500 hover:text-brand-turquoise mb-4 font-semibold flex items-center">
                                            &larr; Geri Dön
                                        </button>
                                        
                                        <div class="bg-brand-light rounded-lg p-4 mb-4 border border-brand-turquoise/20">
                                            <span class="text-xs text-gray-500 font-bold uppercase tracking-wider block mb-1">Seçilen Uzman</span>
                                            <h4 id="secilenHocaIsmi" class="text-lg font-bold text-brand-dark"></h4>
                                        </div>

                                        <form id="publicRezForm">
                                            <input type="hidden" id="formHoca" required>
                                            
                                            <div class="grid grid-cols-2 gap-4 mb-4">
                                                <div>
                                                    <label class="block text-sm font-bold text-gray-700 mb-1">Tarih</label>
                                                    <input type="date" id="formTarih" class="w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:border-brand-turquoise focus:outline-none focus:ring-1 focus:ring-brand-turquoise" required>
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-bold text-gray-700 mb-1">Saat Seçin</label>
                                                    <select id="formSaat" class="w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:border-brand-turquoise focus:outline-none focus:ring-1 focus:ring-brand-turquoise bg-white disabled:bg-gray-100" required disabled>
                                                        <option value="">Önce tarih seçin</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="mb-4">
                                                <label class="block text-sm font-bold text-gray-700 mb-1">Adınız Soyadınız</label>
                                                <input type="text" id="formKisiAdi" class="w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:border-brand-turquoise focus:outline-none focus:ring-1 focus:ring-brand-turquoise" placeholder="Örn: Ayşe Yılmaz" required>
                                            </div>

                                            <div class="mb-6">
                                                <label class="block text-sm font-bold text-gray-700 mb-1">Telefon Numaranız</label>
                                                <input type="tel" id="formTelefon" class="w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 focus:border-brand-turquoise focus:outline-none focus:ring-1 focus:ring-brand-turquoise tracking-wider" placeholder="05XX XXX XX XX" maxlength="14" required>
                                            </div>

                                            <button type="submit" id="gonderBtn" class="w-full flex justify-center rounded-md bg-brand-turquoise px-3 py-3 text-sm font-bold text-white shadow-sm hover:bg-teal-700 disabled:opacity-50 disabled:cursor-not-allowed">
                                                Randevu Talep Et
                                            </button>
                                            <p class="text-xs text-center text-gray-400 mt-3">*Talebiniz incelenip SMS ile onay mesajı gönderilecektir.</p>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                            <button type="button" onclick="kapatModal()" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">İptal</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

	</main>
</Layout>

<script is:inline>
    // MANUVİTAL REZERVASYON (YÖNETİM) PANELİNİN DOMAİNİ 
    // ÖNEMLİ: Bu link yönetim panelini yayınladığın sitenin asıl adresi olmalı (Sonunda slash / olmasın)
    const API_URL = 'https://rezervasyon.manuvital.com'; 

    function kapatModal() {
        document.getElementById('randevuModal').classList.add('hidden');
        geriDon(); // Kapanırken başa sarsın
    }

    function geriDon() {
        document.getElementById('takvimEkrani').classList.add('hidden');
        document.getElementById('secimEkrani').classList.remove('hidden');
        document.getElementById('publicRezForm').reset();
        document.getElementById('formSaat').innerHTML = '<option value="">Önce tarih seçin</option>';
        document.getElementById('formSaat').disabled = true;
    }

    function takvimeGec(hocaKey) {
        document.getElementById('secimEkrani').classList.add('hidden');
        document.getElementById('takvimEkrani').classList.remove('hidden');
        
        document.getElementById('formHoca').value = hocaKey;
        document.getElementById('secilenHocaIsmi').innerText = hocaKey === 'irem' ? 'İrem Hoca (Manuel Terapi)' : 'Erdoğan Hoca (Manuel Terapi)';
        
        // Bugünü minimum tarih olarak ayarla
        const bugun = new Date().toISOString().split('T')[0];
        document.getElementById('formTarih').setAttribute('min', bugun);
    }

    // Telefon maskesi (05XX XXX XX XX)
    document.getElementById('formTelefon').addEventListener('input', function (e) {
        let val = e.target.value.replace(/\D/g, ''); 
        if (val.length > 0 && val[0] !== '0') val = '0' + val; 
        if (val.length > 1 && val[1] !== '5') val = val.substring(0, 1) + '5' + val.substring(2); 
        
        let res = '';
        if (val.length > 0) res += val.substring(0, 4); 
        if (val.length > 4) res += ' ' + val.substring(4, 7); 
        if (val.length > 7) res += ' ' + val.substring(7, 9); 
        if (val.length > 9) res += ' ' + val.substring(9, 11); 
        e.target.value = res;
    });

    // Tarih seçildiğinde Müsait Saatleri (API'den) getir
    document.getElementById('formTarih').addEventListener('change', async function() {
        const tarih = this.value;
        const hoca = document.getElementById('formHoca').value;
        const saatSelect = document.getElementById('formSaat');

        if (!tarih) return;

        saatSelect.disabled = true;
        saatSelect.innerHTML = '<option value="">Saatler yükleniyor...</option>';

        try {
            const response = await fetch(`${API_URL}/api/public-musaitlik?tarih=${tarih}&hoca=${hoca}`);
            
            if (!response.ok) throw new Error("Sunucuya bağlanılamadı.");
            
            const saatler = await response.json();

            saatSelect.innerHTML = '<option value="">Lütfen saat seçin</option>';
            if (saatler.length === 0) {
                saatSelect.innerHTML = '<option value="">Bu gün için boş saat kalmamıştır.</option>';
            } else {
                saatler.forEach(saat => {
                    const opt = document.createElement('option');
                    opt.value = saat;
                    opt.innerText = saat;
                    saatSelect.appendChild(opt);
                });
                saatSelect.disabled = false;
            }
        } catch (error) {
            saatSelect.innerHTML = '<option value="">Sistemde bir hata oluştu.</option>';
        }
    });

    // Formu Gönder (Rezervasyon Talebi)
    document.getElementById('publicRezForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const tel = document.getElementById('formTelefon').value;
        if(tel.length < 14) {
            alert("Lütfen telefon numaranızı tam giriniz.");
            return;
        }

        const btn = document.getElementById('gonderBtn');
        btn.disabled = true;
        btn.innerText = "İletiliyor...";

        try {
            const formData = {
                tarih: document.getElementById('formTarih').value,
                saat: document.getElementById('formSaat').value,
                hoca: document.getElementById('formHoca').value,
                kisiAdi: document.getElementById('formKisiAdi').value,
                telefon: tel
            };

            const res = await fetch(`${API_URL}/api/public-musaitlik`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });

            const data = await res.json();

            if (res.ok) {
                alert(data.message || "Talebiniz başarıyla alındı.");
                kapatModal();
            } else {
                alert(data.error || "İşlem başarısız oldu. Lütfen tekrar deneyin.");
            }

        } catch (error) {
            alert("Sunucuya bağlanılamadı. Lütfen kliniği direkt arayınız.");
        } finally {
            btn.disabled = false;
            btn.innerText = "Randevu Talep Et";
        }
    });
</script>